---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MonitorCard from '../components/MonitorCard.astro';
import Footer from '../components/Footer.astro';
import UtilityBar from '../components/UtilityBar.astro';
import { getStatusApiData } from '../lib/api.js';
import { parseConfig } from '../../../src/config/index.js';
import { interpolateSecrets } from '../../../src/utils/interpolate.js';
import type { Config } from '../../../src/config/types.js';
import type { TraceStats, Verdict } from '../lib/status.js';
import { computeTraceStats, overallVerdict, sortMonitors } from '../lib/status.js';
import { env } from 'cloudflare:workers';

let data: Awaited<ReturnType<typeof getStatusApiData>> | null = null;
let error: Error | null = null;
let banner: { url: string; link?: string } | undefined = undefined;
let config: Config | null = null;

try {
  const envAny = env as any;
  const monitorsConfig = envAny.MONITORS_CONFIG;
  if (typeof monitorsConfig !== 'string' || !monitorsConfig) {
    throw new Error('MONITORS_CONFIG environment variable is not set or is not a string');
  }
  const configYaml = interpolateSecrets(monitorsConfig, envAny);
  config = parseConfig(configYaml);
  data = await getStatusApiData(env.DB, config);

  const bannerUrl = envAny.STATUS_BANNER_URL;
  const bannerLink = envAny.STATUS_BANNER_LINK;
  banner = bannerUrl ? { url: bannerUrl, link: bannerLink } : undefined;
} catch (err) {
  console.error('Failed to fetch status data:', err);
  error = err as Error;
}

const now = data?.lastUpdated ?? Math.floor(Date.now() / 1000);
const sortedMonitors = data ? sortMonitors(data.monitors) : [];

const statsById: Record<string, TraceStats> = {};
if (data) {
  for (const monitor of data.monitors) {
    statsById[monitor.name] = computeTraceStats(monitor.recentChecks);
  }
}

const verdict: Verdict = overallVerdict(sortedMonitors);

let onset: { label: string; timestamp: number } | undefined;
if (data) {
  const affected = sortedMonitors.filter(
    monitor => monitor.status === 'down' || monitor.status === 'maintenance'
  );
  if (affected.length === 1) {
    const monitor = affected[0];
    const stats = statsById[monitor.name];
    const since = monitor.status === 'down' ? stats?.downSince : stats?.maintenanceSince;
    if (since) {
      onset = {
        label: monitor.status === 'down' ? 'Down' : 'Maintenance',
        timestamp: since,
      };
    }
  }
}

const title = data?.title ?? config?.settings.title ?? 'Atalaya Uptime Monitor';
const description = data
  ? `${verdict.label} — ${verdict.detail}. Live status for ${title}.`
  : 'Live service status.';
---

<Layout title={title} description={description}>
  <main id="main-content" class="page">
    {
      error ? (
        <>
          <UtilityBar title={title} />
          <section class="state" role="alert">
            <h1>Status unavailable</h1>
            <p>Status data could not be loaded. The monitors may still be running.</p>
            <button class="retry" type="button" onclick="window.location.reload()">
              Retry
            </button>
          </section>
          <Footer />
        </>
      ) : !data ? (
        <>
          <UtilityBar title={title} />
          <section class="state">
            <h1>Loading status</h1>
            <p>Waiting for the first status check.</p>
          </section>
          <Footer />
        </>
      ) : data.monitors.length === 0 ? (
        <>
          <UtilityBar title={title} banner={banner} />
          <section class="state">
            <h1>No services configured</h1>
            <p>The status page has no monitors yet.</p>
            <p class="state-note">
              Add monitors to <code>MONITORS_CONFIG</code> to start.
            </p>
          </section>
          <Footer />
        </>
      ) : (
        <>
          <Header
            title={data.title}
            lastUpdated={now}
            banner={banner}
            verdict={verdict}
            onset={onset}
            incidents={data.incidents}
          />

          <div class="services">
            {sortedMonitors.map(monitor => (
              <MonitorCard
                monitor={monitor}
                stats={statsById[monitor.name]}
                now={now}
              />
            ))}
          </div>

          <Footer />
        </>
      )
    }
  </main>
</Layout>

<style>
  .page {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px) var(--space-2xl);
  }

  .services {
    min-width: 0;
  }

  .state {
    max-width: 48rem;
    padding: clamp(3rem, 10vw, 7rem) 0;
    border-bottom: 1px solid var(--rule);
  }

  .state h1 {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .state p {
    max-width: 52ch;
    margin-top: var(--space-md);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .state-note {
    font-family: var(--font-mono);
    font-size: var(--text-sm) !important;
    color: var(--ink-3) !important;
  }

  .state code {
    font-family: var(--font-mono);
    color: var(--ink);
  }

  .retry {
    margin-top: var(--space-lg);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--ink);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .retry:hover {
    background: var(--ink);
    color: var(--ground);
  }

  @media (max-width: 560px) {
    .page {
      padding-bottom: var(--space-xl);
    }
  }
</style>
