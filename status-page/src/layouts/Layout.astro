---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Live service status.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'atalaya-theme';
        var root = document.documentElement;
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

        function stored() {
          var value = localStorage.getItem(STORAGE_KEY);
          return value === 'light' || value === 'dark' ? value : null;
        }

        function apply(theme) {
          root.setAttribute('data-theme', theme);
        }

        apply(stored() || (prefersDark.matches ? 'dark' : 'light'));

        prefersDark.addEventListener('change', function (event) {
          if (stored()) return;
          var theme = event.matches ? 'dark' : 'light';
          apply(theme);
          document.dispatchEvent(new CustomEvent('atalaya:theme', { detail: { theme: theme } }));
        });

        window.__atalayaTheme = {
          get: function () {
            return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          },
          set: function (theme) {
            root.setAttribute('data-theme', theme);
            localStorage.setItem(STORAGE_KEY, theme);
          },
          clear: function () {
            localStorage.removeItem(STORAGE_KEY);
          },
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to status</a>
    <slot />
    <script src="../scripts/charts.ts"></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
