---
import type { Incident } from '@worker/types';
import { formatIncidentTime } from '../lib/header.js';

interface Props {
  incidents?: Incident[];
}

const { incidents = [] } = Astro.props;
---

{
  incidents.length > 0 ? (
    <section class="incidents" aria-labelledby="incidents-title">
      <h2 id="incidents-title">Incidents</h2>
      <ol>
        {incidents.map(incident => (
          <li>
            <time datetime={incident.time}>{formatIncidentTime(incident.time)}</time>
            <p>{incident.description}</p>
          </li>
        ))}
      </ol>
    </section>
  ) : null
}

<style>
  .incidents {
    border-top: 1px solid var(--rule);
    padding: var(--space-sm) 0 0;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  ol {
    list-style: none;
    margin-top: var(--space-2xs);
  }

  li {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--rule);
  }

  li:last-child {
    border-bottom: 0;
  }

  time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    white-space: nowrap;
  }

  p {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--ink);
  }

  @media (max-width: 560px) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
