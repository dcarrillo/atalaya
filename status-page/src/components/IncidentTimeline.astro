---
import type { Incident } from '@worker/types';
import { formatIncidentTime } from '../lib/header.js';

interface Props {
  incidents?: Incident[];
}

const { incidents } = Astro.props;
---

{incidents && incidents.length > 0 ? (
  <section class="incident-timeline" aria-label="Incident timeline">
    <h2 class="incident-title">Incidents</h2>
    <ol class="incident-list">
      {incidents.map(incident => (
        <li class="incident-entry">
          <time class="incident-time" datetime={incident.time}>
            {formatIncidentTime(incident.time)}
          </time>
          <p class="incident-description">{incident.description}</p>
        </li>
      ))}
    </ol>
  </section>
) : null}

<style>
  .incident-timeline {
    margin-top: var(--space-md);
  }

  .incident-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    font-weight: var(--font-medium);
    color: var(--color-incident);
    margin: 0 0 var(--space-xs);
  }

  .incident-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .incident-entry {
    position: relative;
    padding: 0 0 var(--space-sm) var(--space-lg);
  }

  .incident-entry::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-incident);
  }

  .incident-entry:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 3px;
    top: 1em;
    bottom: 0;
    width: 1px;
    background: var(--color-incident-border);
  }

  .incident-time {
    display: block;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-incident);
    margin-bottom: var(--space-2xs);
  }

  .incident-description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: var(--leading-normal);
  }
</style>
