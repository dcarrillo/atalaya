---
import type { Incident } from '@worker/types';
import type { Verdict } from '../lib/status.js';
import { formatUtcTime } from '../lib/status.js';
import UtilityBar from './UtilityBar.astro';
import IncidentTimeline from './IncidentTimeline.astro';

interface Props {
  title: string;
  lastUpdated: number;
  banner?: { url?: string; link?: string };
  verdict: Verdict;
  onset?: { label: string; timestamp: number };
  incidents?: Incident[];
}

const { title, lastUpdated, banner, verdict, onset, incidents } = Astro.props;

const words = verdict.label.split(' ');
const accent = words.length > 1 ? words.pop()! : words[0];
const lead = words.join(' ');
---

<header>
  <UtilityBar title={title} lastUpdated={lastUpdated} banner={banner} />

  <div class="summary" data-tone={verdict.tone}>
    <h1>
      {lead}{lead ? ' ' : ''}<span class="accent">{accent}</span>
    </h1>
    <p class="detail">{verdict.detail}</p>
    {onset ? (
      <p class="onset">
        {onset.label} since{' '}
        <time datetime={new Date(onset.timestamp * 1000).toISOString()}>
          {formatUtcTime(onset.timestamp)}
        </time>
      </p>
    ) : null}
  </div>

  <IncidentTimeline incidents={incidents} />
</header>

<style>
  .summary {
    padding: var(--space-lg) 0 var(--space-md);
    --tone: var(--ink);
  }

  .summary[data-tone='ok'] {
    --tone: var(--up);
  }

  .summary[data-tone='partial'],
  .summary[data-tone='major'] {
    --tone: var(--down);
  }

  .summary[data-tone='maintenance'] {
    --tone: var(--maint);
  }

  .summary[data-tone='unknown'] {
    --tone: var(--unknown);
  }

  h1 {
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .accent {
    color: var(--tone);
  }

  .detail {
    max-width: 60ch;
    margin-top: var(--space-xs);
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .onset {
    margin-top: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.03em;
    color: var(--ink-3);
  }

  .onset time {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 560px) {
    .summary {
      padding-top: var(--space-md);
    }

    h1 {
      max-width: 20ch;
      font-size: clamp(1.6rem, 6.6vw, 2rem);
    }

    .detail {
      font-size: var(--text-sm);
    }
  }
</style>
