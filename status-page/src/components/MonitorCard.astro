---
import type { ApiMonitorStatus } from '@worker/types';
import UptimeBars from './UptimeBars.astro';
import { formatLastChecked } from '../lib/monitor-card.js';

interface Props {
  monitor: ApiMonitorStatus;
}

const { monitor } = Astro.props;

const uptimeFormatted = monitor.uptimePercent.toFixed(2);
const lastCheckedText = formatLastChecked(monitor.lastChecked);

const statusLabel =
  monitor.status === 'up' ? 'Operational' :
  monitor.status === 'down' ? 'Down' :
  monitor.status === 'maintenance' ? 'Maintenance' : 'Unknown';

const chartData = JSON.stringify({
  timestamps: monitor.recentChecks.map(c => c.timestamp),
  responseTimes: monitor.recentChecks.map(c => c.responseTimeMs),
  statuses: monitor.recentChecks.map(c => c.status),
});
---

<article class="monitor-card" aria-labelledby={`monitor-${monitor.name.replace(/\s+/g, '-').toLowerCase()}-title`}>
  <div class="monitor-head">
    <div
      class:list={['status-dot', `status-dot-${monitor.status}`]}
      role="status"
      aria-label={`Status: ${statusLabel}`}
      title={statusLabel}
    ></div>
    <h3 class="monitor-name" id={`monitor-${monitor.name.replace(/\s+/g, '-').toLowerCase()}-title`} title={monitor.name}>
      {monitor.name}
      {monitor.status === 'maintenance' && (
        <span class="maintenance-badge" title="Scheduled Maintenance">Maintenance</span>
      )}
    </h3>
    <span class:list={['monitor-uptime', `uptime-${monitor.status}`]} aria-label={monitor.status === 'maintenance' ? 'Scheduled Maintenance' : undefined}>{uptimeFormatted}%</span>
    <span class="monitor-meta">{lastCheckedText}</span>
  </div>

  <UptimeBars dailyHistory={monitor.dailyHistory} />

  <div class="chart-section">
    <div class="chart-labels">
      <span class="section-label">Response time</span>
      <span class="section-label">24h</span>
    </div>
    <div class="chart-container" data-monitor={monitor.name}>
      <script is:inline type="application/json" set:html={chartData} />
    </div>
  </div>
</article>

<style>
  .monitor-card {
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .monitor-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .monitor-head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .status-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    opacity: 0.3;
    z-index: -1;
  }

  .status-dot-up {
    background: var(--color-up);
    box-shadow: 0 0 12px var(--color-up-glow);
  }
  .status-dot-up::after {
    background: var(--color-up);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .status-dot-down {
    background: var(--color-down);
    box-shadow: 0 0 12px var(--color-down-glow);
  }
  .status-dot-down::after {
    background: var(--color-down);
    animation: pulse-glow 1.5s ease-in-out infinite;
  }

  .status-dot-unknown {
    background: var(--color-unknown);
    box-shadow: 0 0 12px var(--color-unknown-glow);
  }
  .status-dot-unknown::after {
    background: var(--color-unknown);
    animation: pulse-glow 3s ease-in-out infinite;
  }

  .status-dot-maintenance {
    background: var(--color-maintenance);
    box-shadow: 0 0 12px var(--color-maintenance-glow);
  }
  .status-dot-maintenance::after {
    background: var(--color-maintenance);
    animation: pulse-glow 1.5s ease-in-out infinite;
  }

  .uptime-maintenance {
    color: var(--color-maintenance);
  }

  .maintenance-badge {
    display: inline-block;
    margin-left: 0.5em;
    padding: 0.1em 0.5em;
    font-size: var(--text-xs);
    background: var(--color-maintenance-bg);
    color: var(--color-maintenance);
    border-radius: var(--radius-xs);
    font-weight: var(--font-semibold);
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    vertical-align: middle;
  }

  @keyframes pulse-glow {
    0%, 100% {
      opacity: 0.3;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 0.55;
      transform: translate(-50%, -50%) scale(1.15);
    }
  }

  .monitor-name {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-ink);
    word-break: break-word;
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  .monitor-uptime {
    margin-left: auto;
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    letter-spacing: -0.03em;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
  }

  .uptime-up { color: var(--color-up); }
  .uptime-down { color: var(--color-down); }
  .uptime-unknown { color: var(--color-ink-2); }

  .monitor-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    margin-left: var(--space-xs);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .chart-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2xs);
  }

  .section-label {
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-medium);
  }

  .chart-container {
    width: 100%;
    height: 7.5rem;
    background: var(--color-paper-3);
    border: 1px solid var(--color-rule-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    touch-action: pan-y;
    position: relative;
  }

  @media (max-width: 640px) {
    .monitor-card {
      padding: var(--space-md);
    }

    .monitor-head {
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .monitor-name {
      font-size: var(--text-sm);
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .monitor-uptime {
      font-size: var(--text-lg);
      margin-left: 0;
      width: 100%;
      text-align: right;
      margin-top: var(--space-2xs);
    }

    .monitor-meta { display: none; }

    .chart-container {
      height: 5rem;
      margin-top: var(--space-sm);
    }
  }

  @media (max-width: 375px) {
    .monitor-card {
      padding: var(--space-sm);
    }

    .monitor-uptime {
      font-size: var(--text-md);
    }

    .chart-container {
      height: 4rem;
    }
  }
</style>
