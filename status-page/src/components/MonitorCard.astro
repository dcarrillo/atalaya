---
import type { ApiMonitorStatus } from '@worker/types';
import type { TraceStats } from '../lib/status.js';
import { formatDuration, formatShortDate, formatUtcTime, statusWord } from '../lib/status.js';
import { formatUptime } from '../lib/monitor-card.js';
import { uptimeWindowLabels } from '../lib/uptime-bars.js';
import UptimeHistory from './UptimeHistory.astro';

interface Props {
  monitor: ApiMonitorStatus;
  stats: TraceStats;
  now: number;
}

const { monitor, stats, now } = Astro.props;

const tone = monitor.status;
const state = statusWord(monitor.status);
const since =
  monitor.status === 'down'
    ? stats.downSince
    : monitor.status === 'maintenance'
      ? stats.maintenanceSince
      : null;
const capped =
  monitor.status === 'down'
    ? stats.downSinceCapped
    : monitor.status === 'maintenance'
      ? stats.maintenanceSinceCapped
      : false;
const duration = since != null ? formatDuration(Math.max(0, now - since)) : null;
const durationLabel = duration ? (capped ? '24h+' : duration) : null;

const uptimeLabels = uptimeWindowLabels(monitor.dailyHistory);
const uptimeLabel = uptimeLabels.heading;
const uptimeShort =
  uptimeLabels.heading === '90-day uptime'
    ? '90d'
    : `since ${formatShortDate(uptimeLabels.start)}`;
const lastCheck = stats.lastCheckAt ? formatUtcTime(stats.lastCheckAt) : 'Never';

const formatMs = (value: number | null): string =>
  value == null ? '—' : `${Math.round(value)} ms`;

let note: string | null = null;
if (stats.totalChecks === 0) {
  note = 'No checks in the last 24 hours.';
} else if (monitor.status === 'down' && stats.downSince) {
  note = stats.downSinceCapped
    ? 'No response for more than 24 hours.'
    : `No response since ${formatUtcTime(stats.downSince)}.`;
} else if (monitor.status === 'maintenance' && stats.maintenanceSince) {
  note = stats.maintenanceSinceCapped
    ? 'Maintenance for more than 24 hours.'
    : `Maintenance since ${formatUtcTime(stats.maintenanceSince)}.`;
} else if (monitor.status === 'unknown') {
  note = 'No status recorded yet.';
}

const chartData = JSON.stringify({
  name: monitor.name,
  timestamps: monitor.recentChecks.map(check => check.timestamp),
  responseTimes: monitor.recentChecks.map(check => check.responseTimeMs),
  statuses: monitor.recentChecks.map(check => check.status),
});

const chartLabel = `${monitor.name}: ${state}. ${
  stats.p50 != null
    ? `Median ${Math.round(stats.p50)} milliseconds, 95th percentile ${Math.round(
        stats.p95 ?? stats.p50
      )} milliseconds.`
    : 'No successful checks in the window.'
} ${
  monitor.uptimePercent != null
    ? `${uptimeLabel} ${monitor.uptimePercent.toFixed(2)} percent.`
    : 'No uptime data.'
}`;
---

<article class="service" data-tone={tone}>
  <header class="service-head">
    <div class="service-title">
      <span class="marker" aria-hidden="true"></span>
      <h2>{monitor.name}</h2>
    </div>

    <p class="state">
      <span class="state-word">{state}</span>
      {durationLabel ? <span class="state-duration">{durationLabel}</span> : null}
    </p>

    <p class="uptime">
      <span class="uptime-value num">{formatUptime(monitor.uptimePercent)}</span>
      <span class="uptime-label">{uptimeLabel}</span>
      <span class="uptime-label-short">{uptimeShort}</span>
    </p>
  </header>

  <p class="service-meta">Last check {lastCheck}</p>

  <UptimeHistory days={monitor.dailyHistory} />

  <figure class="trace">
    <figcaption>
      <span class="trace-title">Response time · 24h</span>
      <span class="trace-stats num">
        p50 {formatMs(stats.p50)} <span aria-hidden="true">·</span> p95 {formatMs(stats.p95)}
      </span>
    </figcaption>

    <div class="chart" data-chart role="img" aria-label={chartLabel}>
      <script is:inline type="application/json" set:html={chartData} />
      <div class="chart-skeleton" aria-hidden="true">Loading chart…</div>
    </div>

    {note ? <p class="note">{note}</p> : null}
  </figure>
</article>

<style>
  .service {
    border-top: 1px solid var(--rule);
    padding: var(--space-md) 0 var(--space-lg);
    min-width: 0;
  }

  .service[data-tone='down'],
  .service[data-tone='maintenance'] {
    border-top-width: 2px;
  }

  .service[data-tone='down'] {
    border-top-color: var(--down);
  }

  .service[data-tone='maintenance'] {
    border-top-color: var(--maint);
  }

  .service-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--space-xs) var(--space-lg);
  }

  .service-title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
  }

  .marker {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--up);
  }

  .service[data-tone='down'] .marker {
    background: var(--down);
  }

  .service[data-tone='maintenance'] .marker {
    background: var(--maint);
  }

  .service[data-tone='unknown'] .marker {
    background: var(--unknown);
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .state {
    display: flex;
    align-items: baseline;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .state-word {
    font-weight: 500;
  }

  .service[data-tone='down'] .state-word {
    color: var(--down);
  }

  .service[data-tone='maintenance'] .state-word {
    color: var(--maint);
  }

  .service[data-tone='up'] .state-word {
    color: var(--up);
  }

  .state-duration {
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-3);
  }

  .uptime {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    text-align: right;
  }

  .uptime-value {
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
  }

  .uptime-label,
  .uptime-label-short {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .uptime-label-short {
    display: none;
  }

  .service-meta {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }

  .trace {
    margin-top: var(--space-sm);
  }

  figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3px;
  }

  .trace-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .trace-stats {
    font-size: var(--text-xs);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .trace-stats span {
    margin: 0 3px;
    color: var(--ink-3);
  }

  .chart {
    position: relative;
    width: 100%;
    height: 170px;
    min-width: 0;
  }

  .chart :global(.uplot) {
    width: 100% !important;
    height: 100% !important;
    font-family: var(--font-mono) !important;
  }

  .chart :global(.u-over) {
    cursor: crosshair;
  }

  .chart :global(.u-cursor-x) {
    border-right-color: var(--rule-strong) !important;
  }

  .chart :global(.u-cursor-pt) {
    border-width: 2px !important;
  }

  .note {
    margin-top: 3px;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    .service-head {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 4px;
    }

    .service-title {
      grid-column: 1 / -1;
    }

    .chart {
      height: 150px;
    }

    figcaption {
      flex-wrap: wrap;
      gap: 1px var(--space-sm);
    }
  }

  @media (max-width: 420px) {
    .uptime-label {
      display: none;
    }

    .uptime-label-short {
      display: inline;
    }

    .chart {
      height: 140px;
    }
  }
</style>
